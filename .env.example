# Copy this file to .env.local and fill in values from
# Firebase console → Project settings → General → Your apps → Web app config.
# If these are left empty the app falls back to browser localStorage (demo mode).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email (optional): address of the Cloudflare Worker in email-worker/ that sends PDFs via Brevo,
# e.g. https://sn-enterprises-email.<your-subdomain>.workers.dev  — leave empty to hide email sending.
VITE_EMAIL_API_URL=
